# Regras processadas pelo Cloudflare Pages (este arquivo nao e servido ao navegador).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()

# Os bundles do Next tem hash no nome e podem ser armazenados por longo prazo.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Previews nao devem ser indexados; o pages.dev principal pode ser o dominio oficial.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
